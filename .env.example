# Production bootstrap values. Set real values outside source control.
ROOTINS_ADMIN_NAME=REPLACE_WITH_ADMIN_NAME
ROOTINS_ADMIN_EMAIL=REPLACE_WITH_ADMIN_EMAIL
ROOTINS_ADMIN_PASSWORD=REPLACE_WITH_A_SECURE_PASSWORD
ROOTINS_ADMIN_CLINIC_ID=REPLACE_WITH_ACTIVE_CLINIC_ID
# Video consultation provider (optional when configured from Admin > Integrations > Video Consultation)
# VIDEO_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_API_KEY_SID=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_API_KEY_SECRET=replace-with-server-only-secret
# VIDEO_RECORDING_ENABLED=false
